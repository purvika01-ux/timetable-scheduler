# Copy to .env for local development. Never commit .env.
# Values below are local-only placeholders; real secrets live in the host secret store.

# Environment name: development | test | staging | production
APP_ENV=development

# PostgreSQL (local Docker container). Phase 1 adds separate api / worker / migrator roles.
POSTGRES_USER=timetable
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=timetable
POSTGRES_PORT=5432
DATABASE_URL=postgresql://timetable:local-dev-only-change-me@localhost:5432/timetable

# Redis (job queue)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API
API_PORT=8000
# Exact origins allowed by CORS, comma separated (D24)
CORS_ORIGINS=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
