# College Timetable Optimizer API: example configuration.
# Copy to apps/api/.env and fill in real values. Never commit .env.
# Every value here is a placeholder.

# development | test | production
NODE_ENV=development

# Where the API listens. Use 0.0.0.0 only behind a reverse proxy in production.
HOST=127.0.0.1
PORT=4000

# MongoDB connection string. For local development with the MongoDB service:
#   mongodb://127.0.0.1:27017/timetable_dev
# For a hosted database, use the connection string from your provider's console
# (keep the username and password only in your local .env or the host's secret store).
MONGODB_URI=mongodb://127.0.0.1:27017/timetable_dev

# Comma-separated list of exact browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set to the number of trusted reverse proxies in front of the API (0 when running directly).
TRUST_PROXY=0

# Milliseconds to wait for open requests to finish on shutdown before exiting.
SHUTDOWN_TIMEOUT_MS=10000

# Milliseconds to wait when looking for a MongoDB server before reporting it unavailable.
DB_SERVER_SELECTION_TIMEOUT_MS=5000
