# College Timetable Optimizer web app: example configuration.
# Copy to apps/web/.env.local only if you want the app to talk to the API.
# The app works without it (all current screens use data saved in the browser).

# Origin of the API (no path). Public: it is built into the browser bundle, so never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
